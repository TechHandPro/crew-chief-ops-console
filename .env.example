# CREW CHIEF Ops Console — environment reference
# Copy to .env.local for local runs. Never commit real values.
#
# The console is a template. With no environment at all it runs the built-in
# demo dataset. Everything that names a specific company or system of record
# is opt-in below.

# ── System of record ─────────────────────────────────────────────────────────
# "fixtures" uses the built-in demo dataset (no credentials needed).
# "tnt-mcp" reads live from a TNT instance over MCP. A third adapter gets its
# own value; see src/lib/sor/provider.ts.
# Defaults: tnt-mcp when TNT_MCP_API_KEY is set, otherwise fixtures.
# Production refuses to start without an explicit choice.
SOR_PROVIDER=fixtures

# Label shown in the connection badge for the live system of record.
# Defaults to the adapter's own name ("TNT" for tnt-mcp).
# SOR_SYSTEM_NAME=

# Deep-link templates into the system of record's web UI. {id} is expanded.
SOR_TICKET_URL_TEMPLATE=/tickets/{id}
SOR_DOCUMENT_URL_TEMPLATE=/documents/{id}/edit
SOR_VAULT_URL_TEMPLATE=/vault

# In-process read cache (seconds). 0 disables.
SOR_CACHE_TTL_SECONDS=30

# ── TNT adapter (SOR_PROVIDER=tnt-mcp) ───────────────────────────────────────
# MCP endpoint (FastMCP over Streamable HTTP). https required except loopback.
TNT_MCP_URL=https://ai.techhand.pro/mcp

# Public web UI of the same instance, used for deep links.
TNT_WEB_BASE_URL=https://ai.techhand.pro

# Organization API key from TNT → Organization → API Keys. Sent as
# `Authorization: Bearer …`. Needs read scopes only:
#   mcp:tickets:read  mcp:docs:read  mcp:vault:read
# (+ mcp:repo:resolve if you set a repository pin below, and
#  mcp:platform:cross_org if this is a platform key serving several orgs).
# The MCP actor user behind the key must hold page:vault for vault metadata.
TNT_MCP_API_KEY=

# Organization pin. REQUIRED. Sent as organization_id on every ticket,
# document, and vault list, so reads work without a linked GitHub repository
# and can never drift to another tenant.
TNT_ORGANIZATION_ID=

# Repository pin (optional, informational). When set, the console calls
# tnt_resolve_repo once per session and shows the linked repo/work ticket in
# the connection badge. If the repository is not linked in TNT, the console
# keeps reading through the organization pin and shows a routing note.
TNT_GIT_REPOSITORY_ID=
TNT_REPO_SLUG=

# ── Console access ───────────────────────────────────────────────────────────
# Shared operator token entered on the sign-in page. Required in production
# unless OPS_CONSOLE_ALLOW_ANONYMOUS=true (only behind an identity-aware proxy).
#   generate: openssl rand -base64 24
OPS_CONSOLE_ACCESS_TOKEN=

# HMAC key for session cookies. Required in production when a token is set.
#   generate: openssl rand -hex 32
OPS_CONSOLE_SESSION_SECRET=

# Session lifetime in hours (default 12, max 168).
OPS_CONSOLE_SESSION_TTL_HOURS=12

# Explicit opt-out of the token gate. Leave unset.
# OPS_CONSOLE_ALLOW_ANONYMOUS=true

# ── Branding ─────────────────────────────────────────────────────────────────
# Defaults are the generic CREW CHIEF template. A deployment re-labels itself
# here only; there are no company names in the code.
OPS_CONSOLE_BRAND_NAME=CREW CHIEF Ops Console
OPS_CONSOLE_BRAND_TAGLINE=Audit what the crew writes

# Example: an operator's internal (dogfood) instance
# OPS_CONSOLE_BRAND_NAME=Acme Ops Console
# OPS_CONSOLE_BRAND_TAGLINE=Internal — reads from Acme's system of record
# SOR_SYSTEM_NAME=Acme TNT
